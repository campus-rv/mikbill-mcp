# Copy to .env and fill in. Used by `docker run --env-file .env` and by docker-compose.yml.
# Do not commit the real file (.env is in .gitignore).

# --- Mikbill (both modes) -------------------------------------------------------------------------
# https only. For a lab installation on plain http, also set MB_INSECURE_HTTP=1 (the login is then not encrypted).
MB_BASE_URL=https://admin.example.com
MB_LOGIN=mcp-agent
MB_PASSWORD=change-me
# Or keep the secret out of the environment (Docker/Kubernetes secrets): MB_PASSWORD_FILE=/run/secrets/mb_password
# read and write are the defaults. finance, account and admin are opt-in: each call needs a reason, and
# bulk tools preview first. The client (harness) asks the user to approve each call; there is no approval token.
# pii is separate: without it, passport, tax id and birth date fields in subscriber records are masked.
MB_SCOPES=read,write
# Largest amount one call may credit to one account, and the largest total of one bulk call. Set them to fit your
# currency and your usual payments.
#MB_MAX_PAYMENT=10000
#MB_MAX_PAYMENT_TOTAL=50000

# --- Streamable HTTP only (ignored in stdio mode) ---------------------------------------------------
# The one bearer token (at least 16 characters). It may use every scope in MB_SCOPES. Generate one with:
#   openssl rand -hex 32
MCP_HTTP_BEARER_TOKEN=
# Extra Host header values (host:port) when you publish another port or serve behind a proxy name:
#MCP_ALLOWED_HOSTS=mcp.example.com
# Browser clients only: allowed Origin values.
#MCP_ALLOWED_ORIGINS=https://app.example.com

# --- Optional ---------------------------------------------------------------------------------------
# JSON-lines audit log of every tool call. The path below is the volume of docker-compose.yml. The server opens the
# file at start-up and stops if it cannot: outside Docker, point it to a directory that exists, or remove the line
# (events then go to the log on stderr only).
MB_AUDIT_FILE=/data/audit.jsonl
# HTTP only: failed logins per client address and minute before the address gets 429 (0 turns it off).
#MB_AUTH_MAX_FAILURES=10
# Private CA for Mikbill: mount the file and point to it. MB_INSECURE_TLS=1 turns verification off (not advised).
#MB_CA_BUNDLE=/certs/ca.pem
